# HTTP port (1-65535); defaults to 3000.
PORT=3000

# PostgreSQL connection string, for example postgresql://user:password@localhost:5432/details
DATABASE_URL=postgresql://details:replace-me@localhost:5432/details

# Maximum duration for each migration database statement, in milliseconds.
MIGRATION_TIMEOUT_MS=30000

# Application mode: development, test, or production.
NODE_ENV=development
