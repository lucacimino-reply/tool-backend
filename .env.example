# HTTP listen port (1-65535); defaults to 3000.
PORT=3000

# Runtime mode; defaults to development (development, test, or production).
NODE_ENV=development

# PostgreSQL connection URL; replace this local placeholder with your database URL.
DATABASE_URL=postgresql://user:password@localhost:5432/tool_backend

# Maximum time to establish a database connection, in milliseconds (1-60000).
CONNECTION_TIMEOUT_MS=5000

# Maximum total time for startup database initialization and migrations, in milliseconds (1-120000).
MIGRATION_TIMEOUT_MS=60000

# Maximum graceful-shutdown duration, in milliseconds (1-120000).
SHUTDOWN_TIMEOUT_MS=10000
