# HTTP port exposed by the server.
PORT=3000
# PostgreSQL connection string. Replace with a local database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clean
# Server-side validity window for a browser session, in hours.
SESSION_DURATION_HOURS=24
# Maximum time in milliseconds to wait for the startup migration lock.
MIGRATION_LOCK_TIMEOUT_MS=30000
# Set to production to add the Secure attribute to the session cookie.
NODE_ENV=development
