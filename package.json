{
  "name": "tool-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run clean && tsc -p tsconfig.test.json && node --test dist-test/tests/submissions.test.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.3",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
